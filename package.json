  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/dcat.git"
  },
  "version": "1.2.0",
  "packageManager": "npm@12.2.0",
  "type": "module",
  "linkedPackage": true,
  "main": "lib/esm/index.js",
